# Скопируйте в .env и поменяйте значения перед деплоем на сервер.
# Этот файл читают и контейнер db, и backend.

# База данных: postgres создаёт БД/пользователя из этих значений, backend подключается по ним же.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mdn

# Адрес БД для backend (по умолчанию контейнер db:5432). Для внешней БД поменяйте DB_HOST/DB_PORT
# или задайте целиком DATABASE_URL — он имеет приоритет над всем остальным.
# DB_HOST=db
# DB_PORT=5432
# DB_SSLMODE=disable
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

JWT_SECRET=long-random-string
ADMIN_EMAIL=admin@mdn.kg
ADMIN_PASSWORD=change-me
